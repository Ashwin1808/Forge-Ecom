# Copy to .env for local use. These defaults match the local development setup.
POSTGRES_PASSWORD=forge_postgres_local_dev
ORDER_DB_PASSWORD=forge_order_local_dev
INVENTORY_DB_PASSWORD=forge_inventory_local_dev

# Application settings
LOG_LEVEL=INFO
ORDER_RATE_LIMIT_PER_MINUTE=120
INVENTORY_RATE_LIMIT_PER_MINUTE=120

# Storefront checkout reservations
CHECKOUT_RESERVATION_TTL_SECONDS=900
CHECKOUT_EXPIRY_ENABLED=true
CHECKOUT_EXPIRY_SWEEP_SECONDS=30
CHECKOUT_EXPIRY_BATCH_SIZE=50
